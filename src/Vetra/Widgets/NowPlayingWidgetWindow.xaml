<Window x:Class="Vetra.Widgets.NowPlayingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vetra.Controls"
        Title="Now Playing"
        Width="420"
        Height="154"
        MinWidth="300"
        MinHeight="126"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False">
  <Border x:Name="Frame"
          CornerRadius="18"
          Background="{StaticResource GlassPanelBrush}"
          MouseLeftButtonDown="Frame_MouseLeftButtonDown">
    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Width="86"
              Height="86"
              CornerRadius="12"
              Background="#202630"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
          <TextBlock x:Name="NoArtText"
                     Text="♪"
                     Foreground="#768192"
                     FontSize="30"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SourceText"
                   Grid.Row="0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="220" />

        <TextBlock x:Name="TitleText"
                   Grid.Row="1"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,8,0,0" />

        <TextBlock x:Name="ArtistText"
                   Grid.Row="2"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,3,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
          <Button x:Name="PreviousButton"
                  Style="{StaticResource MediaIconButtonStyle}"
                  ToolTip="Previous"
                  Click="PreviousButton_Click">
            <controls:SvgIcon Source="Assets/Icons/previous.svg"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Button x:Name="PlayPauseButton"
                  Style="{StaticResource MediaIconButtonStyle}"
                  ToolTip="Play/Pause"
                  Margin="8,0"
                  Click="PlayPauseButton_Click">
            <Grid Width="14" Height="14">
              <controls:SvgIcon x:Name="PlayIcon"
                                Source="Assets/Icons/play.svg"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <controls:SvgIcon x:Name="PauseIcon"
                                Source="Assets/Icons/pause.svg"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Visibility="Collapsed" />
            </Grid>
          </Button>
          <Button x:Name="NextButton"
                  Style="{StaticResource MediaIconButtonStyle}"
                  ToolTip="Next"
                  Click="NextButton_Click">
            <controls:SvgIcon Source="Assets/Icons/next.svg"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
